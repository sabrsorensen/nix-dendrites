diff --git a/crates/nh-remote/src/remote.rs b/crates/nh-remote/src/remote.rs
index 1111111..2222222 100644
--- a/crates/nh-remote/src/remote.rs
+++ b/crates/nh-remote/src/remote.rs
@@ -636,7 +636,10 @@ impl RemoteHost {
   /// Get the SSH store URI used by Nix store commands.
   #[must_use]
   pub fn nix_store_uri(&self) -> String {
-    format!("{}://{}", self.store_scheme.as_str(), self.host)
+    // Nix's SSH connection sharing can leak its local "started" readiness
+    // marker into the ssh-ng protocol.  A single direct connection is robust
+    // for deployment closures and leaves raw SSH activation unchanged.
+    format!("{}://{}?max-connections=1", self.store_scheme.as_str(), self.host)
   }
 }
@@ -657,17 +660,8 @@ impl std::fmt::Display for RemoteHost {
 /// Get the default SSH options for connection multiplexing.
 /// Includes a `ControlPath` pointing to our control socket directory.
 fn get_default_ssh_opts() -> Vec<String> {
-  let control_dir = get_ssh_control_dir();
-  let control_path = control_dir.join("ssh-%n");
-
-  vec![
-    "-o".to_string(),
-    "ControlMaster=auto".to_string(),
-    "-o".to_string(),
-    format!("ControlPath={}", control_path.display()),
-    "-o".to_string(),
-    "ControlPersist=60".to_string(),
-  ]
+  // Nix's SSH stores manage their own control socket.  Supplying a second
+  // ControlMaster through NIX_SSHOPTS can corrupt the ssh-ng handshake.
+  Vec::new()
 }
